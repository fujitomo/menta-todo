# ==========================================
# サーバー設定
# ==========================================
# "TRUE" or "FALSE" (AWS Lambdaで実行するかどうか)
SERVER_LAMBDA=FALSE

# ==========================================
# 認証設定
# ==========================================
# JWTトークン生成用のシークレットキー（本番環境では強力なランダム文字列に変更）
JWT_SECRET_KEY="secret"

# ==========================================
# データベース設定
# ==========================================
# "DOCUMENT_DB" or "MONGO_DB"
DB_TYPE="MONGO_DB"

# DocumentDBの設定 (DB_TYPE="DOCUMENT_DB"の場合)
# DocumentDBのクラスターエンドポイント
CLUSTER_ENDPOINT="your-documentdb-cluster-endpoint"
# SSL証明書のパス (AWS Lambdaの場合は /var/task/funcs/global-bundle.pem)
SSL_CERT_PATH=/var/task/funcs/global-bundle.pem

# MongoDBの設定
# ユーザー名
MONGO_USERNAME="mongo-user"
# パスワード（実際のパスワードに置き換えてください）
MONGO_PASSWORD="your-mongo-password-here"
# ホスト名 (Docker Compose内ではサービス名 "mongo")
MONGO_HOSTNAME="mongo"
# ポート番号
MONGO_PORT=27017
# データベース名
MONGO_DB="menta_login"

# ==========================================
# Nginx / SSL設定 (本番環境用)
# ==========================================
# バーチャルホスト名 (例: api.example.com)
VIRTUAL_HOST=
# Let's Encrypt用ホスト名 (通常はVIRTUAL_HOSTと同じ)
LETSENCRYPT_HOST=
# Let's Encrypt登録用メールアドレス
LETSENCRYPT_EMAIL=

# ==========================================
# AWS SES (メール送信) 設定
# ==========================================
# IAMユーザー名 (識別用)
IAM_USERNAME="your-iam-username-here"
# SMTPユーザー名 (SESのSMTP Settingsで作成したもの)
SMTP_USERNAME="your-ses-smtp-username-here"
# SMTPパスワード（実際のパスワードに置き換えてください）
SMTP_PASSWORD="your-smtp-password-here"
# SMTPサーバーホスト (東京リージョンの場合: email-smtp.ap-northeast-1.amazonaws.com)
AWSMAIL_HOST="email-smtp.ap-northeast-1.amazonaws.com"

# 送信元設定 (AWS SESで検証済みのメールアドレス)
FROM_NAME="test"
FROM_EMAIL="your-verified-email@example.com"

# ==========================================
# AWS S3 (ファイルアップロード) 設定
# ==========================================
# S3バケット名
S3_BUCKET_NAME="your-s3-bucket-name-here"
# AWSリージョン (例: ap-northeast-1)
AWS_REGION_NAME="ap-northeast-1"
# AWSアクセスキーID (S3操作権限を持つIAMユーザー)
ACCESS_KEY_ID="your-aws-access-key-id-here"
# AWSシークレットアクセスキー（実際のキーに置き換えてください）
SECRET_ACCESS_KEY="your-aws-secret-access-key-here"
# S3操作用のユーザー名/パスワード (アプリ内で使用する場合)
USER_NAME=""
PASSWORD="your-password-here"
# コンソールログインリンク (通知用など)
CONSOLE_LOGIN_LINK=""

# ==========================================
# AWS CloudFront (署名付きURL) 設定
# ==========================================
# CloudFrontのURL (例: https://dxxxxxxxx.cloudfront.net)
AWS_CLOUDFRONT_URL="your-cloudfront-url.cloudfront.net"
# CloudFrontのキーペアID (公開鍵ID)
AWS_CLOUDFRONT_KEY="your-cloudfront-key-pair-id-here"
# CloudFrontの秘密鍵ファイルのパス (コンテナ内のパス)
AWS_CLOUDFRONT_PEM=""
