class TokenService:
    def __init__(self, secret: SecretStr, algorithm: str = "RS256"):
        self._secret = secret
        self._algorithm = algorithm
    def issue_access(self, user_id: UUID) -> Token:
        now = datetime.now(timezone.utc)
        payload = TokenPayload(
            user_id=user_id,
            type=TokenType.ACCESS,
            exp=now + timedelta(minutes=15),
            iat=now,
