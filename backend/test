# domain/errors.py
class DomainError(Exception):
    def __init__(self, code: ErrorCode, status_code: int = 400):
        self.code = code
        self.status_code = status_code
class UnauthorizedError(DomainError):
    def __init__(self, code: ErrorCode):
        super().__init__(code, status_code=401)
# api/exception_handlers.py
@app.exception_handler(DomainError)
async def domain_error_handler(_: Request, exc: DomainError):
    return JSONResponse(
        status_code=exc.status_code,
        content={"error_code": exc.code.value, "message": exc.code.message},
    )
ExceptionFuncs.raise_xxx(...) の print(...) 副作用を全廃できます。

③ ミドルウェアの AccessHandlingMiddleware を撤廃する
現状の middleware は「全エンドポイント＋全ミドルウェアでトークン検証」をする太いコードですが、Depends(get_current_user) で各ハンドラに注入する方式にすれば

認証必要/不要をルート単位で明示 (Endpoints.get_auth_required_endpoints の手動メンテ廃止)
OpenAPI に自動反映
テストで簡単に override 可能
になります。

