# repositories/registrant_repository.py
class RegistrantRepository:
    def __init__(self, db: AsyncIOMotorDatabase):
        self._collection = db["registrant"]
    async def find_active_by_email(self, email: str) -> Optional[dict]:
        return await self._collection.find_one({
            "email": email,
            "is_authenticated": True,
            "delete_date": None,
        })
# services/auth_service.py
class AuthService:
    def __init__(self, repo: RegistrantRepository, hasher: PasswordHasher,
                 token_service: TokenService):
        self._repo = repo
        self._hasher = hasher
        self._token_service = token_service
    async def authenticate(self, email: str, password: str) -> TokenPair:
        user = await self._repo.find_active_by_email(email)
        # タイミング攻撃対策: ユーザ不在でもダミーハッシュで verify
        hashed = user["password"] if user else DUMMY_HASH
        if not self._hasher.verify(password, hashed) or not user:
            raise UnauthorizedError(ErrorCode.CREDENTIALS_INVALID)
        return await self._token_service.issue_pair(user["user_id"])
# api/v1/auth/login.py
@router.post("/login", response_model=LoginResponse)
async def login(
    payload: LoginRequest,
    auth_service: AuthService = Depends(get_auth_service),
):
    pair = await auth_service.authenticate(payload.email, payload.password)
    return LoginResponse(access_token=pair.access, refresh_token=pair.refresh)
