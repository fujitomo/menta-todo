修正案（middleware を最小化、認証は Depends に寄せる前提のつなぎ）：

class AccessHandlingMiddleware(BaseHTTPMiddleware):
    async def dispatch(self, request: Request, call_next):
        url_path = request.url.path
        method = request.method
        if method == "OPTIONS" or url_path not in Endpoints.get_auth_required_endpoints():
            return await call_next(request)
        access_token = request.headers.get("authorization", "").removeprefix("Bearer ").strip()
        refresh_token = (request.headers.get("refreshtoken") or "").strip()
        if not access_token:
            return _unauthorized_response(ERROR_MESSAGE.TOKEN_EXPIRED)
        if url_path == Endpoints.Auth.email_authentication:
            token_info = AuthFuncs.check_token(access_token, TokenType.TMP.value) \
                or AuthFuncs.check_token(refresh_token, TokenType.TMP.value)
            if not token_info:
                return _unauthorized_response(ERROR_MESSAGE.TOKEN_EXPIRED)
            request.state.token_info = token_info
            return await call_next(request)
        token_info = AuthFuncs.check_token(access_token, TokenType.ACCESS.value)
        new_token = None
        if not token_info:
            if not refresh_token:
                return _unauthorized_response(ERROR_MESSAGE.TOKEN_EXPIRED)
            token_info = AuthFuncs.check_token(refresh_token, TokenType.REFRESH.value)
            if not token_info:
                return _unauthorized_response(ERROR_MESSAGE.TOKEN_EXPIRED)
            new_token = AuthFuncs.get_access_token(str(token_info.user_id))
        request.state.token_info = token_info
        response = await call_next(request)
        if new_token:
            response.headers["newtoken"] = new_token if isinstance(new_token, str) else new_token.decode()
        return response
def _unauthorized_response(message: str) -> JSONResponse:
    return JSONResponse(status_code=401, content={"detail": message})
加えて AuthFuncs.check_token を「type 不一致は raise しない」設計に修正：

@staticmethod
def check_token(token: Optional[str], expected_type: str) -> Optional[TokenPayload]:
    if not token:
        return None
    try:
        payload = jwt.decode(
            token, str(env.JWT_SECRET_KEY), algorithms=["HS256"],
            options={"require": ["exp", "type", "user_id"]},
        )
    except (jwt.ExpiredSignatureError, jwt.InvalidTokenError, jwt.DecodeError, ValueError):
        return None
    if payload.get("type") != expected_type:
        return None
    return TokenPayload(**payload)
これで email_authentication のフォールバックが動作するようになり、middleware の print も不要になります。

総括
このバックエンドは「動くプロトタイプ」としては機能していますが、現状のまま本番投入すると、(a) コミット済みクレデンシャルによる即時アカウント侵害、(b) 認証ミドルウェアのバイパス、(c) JWT/RT 設計の弱さによる長期セッションハイジャック、(d) get_todolist の OOM、(e) update_profile のデータ消失バグ が高確率で発生します。

最優先で「シークレットローテーション + 認証バイパス修正 + JWT 設計刷新」、その後にレイヤー分離 + テスト導入 + CI、最後に長期的な DDD/観測性整備、という3段階で進めることを強く推奨します。

