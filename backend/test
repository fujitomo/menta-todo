① 認証ユーザ取得の Depends 化（middleware から脱却）
# api/deps.py
oauth2_scheme = HTTPBearer(auto_error=True)
async def get_current_user(
    creds: HTTPAuthorizationCredentials = Depends(oauth2_scheme),
    token_service: TokenService = Depends(get_token_service),
    repo: RegistrantRepository = Depends(get_registrant_repo),
) -> User:
    payload = token_service.decode(creds.credentials, expected_type=TokenType.ACCESS)
    user = await repo.find_active_by_user_id(payload.user_id)
    if not user:
        raise UnauthorizedError(ErrorCode.TOKEN_EXPIRED)
    return User.from_dict(user)
